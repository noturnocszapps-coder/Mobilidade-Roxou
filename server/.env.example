# Copie para .env e preencha. O .env nunca vai para o GitHub.
PORTA=3105

# NT Database (PostgreSQL da VPS). Use um usuário só do Roxou Mobilidade.
DATABASE_URL=postgres://roxou_mobilidade:SENHA@127.0.0.1:5432/ntdatabase

# Asaas: chave de API (Minha conta > Integrações). Comece pelo sandbox.
ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_CHAVE=
# Token que você define ao cadastrar o webhook no Asaas (o Asaas manda ele em cada aviso).
ASAAS_WEBHOOK_TOKEN=

# E-mail que envia o código de login (SMTP do seu provedor).
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=Roxou Mobilidade <nao-responda@seudominio.com.br>

# Chave privada da licença (criada por "npm run gerar-chaves").
CHAVE_PRIVADA_ARQUIVO=chaves/licenca-privada.pem
